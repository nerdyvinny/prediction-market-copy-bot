# Copy to .env and fill in. .env is gitignored — NEVER commit real secrets.

# Run mode: paper | backtest | live
PMBOT_MODE=paper

# --- Public, read-only APIs (no key needed for paper/backtest) ---
PMBOT_DATA_API_BASE=https://data-api.polymarket.com
PMBOT_GAMMA_API_BASE=https://gamma-api.polymarket.com
PMBOT_CLOB_API_BASE=https://clob.polymarket.com

# --- Poll loop ---
PMBOT_POLL_INTERVAL_SECONDS=10      # NOT how late we copy. The /trades feed is served through a 300s CDN cache, and our measured copy lag is indistinguishable from a uniform draw over that cache's life (median 149s, KS D=0.060 vs U(0,300), n=148). Polling faster just re-reads one cached page; keep 10s so we pick up each refresh promptly.
PMBOT_COPY_FEED_LAG_SECONDS=140     # measured, not tuned: how far behind the leader the feed runs. The backtester quotes every fill at feed_lag + poll_interval = 150s; at the old 10s it priced fills 15x closer to the leader than the bot can reach. Re-derive with `python -m scripts.measure_copy_lag --db pmbot.db --probe`.
PMBOT_COPY_BYPASS_FEED_CACHE=false  # send a unique param with every /trades call so the CDN must go to origin. Controlled A/B over 30min, both arms polling the same 6 wallets continuously (n=450 paired trades): cached median 270s -> busted median 23s, sooner on 67%. sweep_lag prices that at +22% net over 30d. OFF by default: it deliberately bypasses Polymarket's cache and puts ~6 requests/min/wallet on their origin, which is an operator's call. Raise the poll interval if you turn it on.
PMBOT_SETTLE_INTERVAL_HOURS=0.5     # settle often: resolved-but-unsettled = idle bankroll

# --- Capital & sizing (paper defaults; keep < $1k for live) ---
PMBOT_BANKROLL_USD=500
PMBOT_COPY_FRACTION=0.10            # fraction of a leader's trade size (walk-forward tuned)
# Per-market cap as a FRACTION of bankroll. When set, this REPLACES
# PMBOT_MAX_PER_MARKET_USD entirely — the dollar value below is ignored.
# 2026-08-13: set to 0.03 ($15 on a $500 bankroll), down from a flat $50.
# The flat cap let 11 positions put $439 of $500 to work, so one copy was
# 10% of the book and the book was 88% committed. 3% caps that at ~33%
# across the same 11 markets. Expect proportionally lower P&L: the cap binds
# on every leader trade over $150, and the 2026-08-07 sweep found $50 was the
# P&L-optimal cap. This trades return for survivability on a bankroll that
# cannot be topped up.
PMBOT_MAX_PER_MARKET_PCT=0.03
PMBOT_MAX_PER_MARKET_USD=50         # IGNORED while _PCT is set. (2026-07-31: was 100; halved for drawdown control — at $100 the 60d peak-to-trough swing was $565, above the whole $500 bankroll)
PMBOT_MAX_PER_LEADER_USD=400        # hard cap of total exposure per leader
PMBOT_MIN_MARKET_LIQUIDITY_USD=5000 # skip thin markets (slippage)
PMBOT_COMPOUND_PROFITS=false        # redeploy realized winnings (validated worse ON in 45d test)

# --- Strategy #5 (exact copy — the default strategy) ---
PMBOT_COPY_PRICE_MIN=0.15           # entry band floor (sweep-tuned; sells never filtered)
PMBOT_COPY_PRICE_MAX=0.85           # entry band ceiling
PMBOT_COPY_MAX_PRICE_DRIFT=0.03     # skip if quote moved > this from leader's fill (stale edge)
PMBOT_COPY_MAX_TRADE_AGE_MINUTES=60 # never copy entries older than this (0 = off; exits exempt)
PMBOT_SKIP_ROUND_TRIPPED_ENTRIES=true   # skip an entry the leader already fully exited inside the same fetched tape. Both halves then arrive in one poll cycle, so we'd fill at the ask and unwind at the bid in the same instant — none of the leader's move, the spread paid twice. The age filter can't catch these (the entry really is minutes old, just already dead). 2026-08-02: 180/409 copyable entries (44%) qualify, bimodal — two leaders never round-trip, four scalp with a median hold under a minute. NB the backtest cannot measure this: it fills both legs at the leader's own price, so it books these as winners.
PMBOT_COPY_MIN_LEADER_NOTIONAL_USD=150  # 2026-08-02: RAISED from 50. The 90d walk-forward that justified 50 (4/4 folds beat 300, oos $4,986 vs $3,640) is not admissible — it fills both legs of a round-trip at the leader's own price, so it books the fast in-game scalps that a $50 floor admits as WINNERS. Live they are losers: 5/5 of them lost, entered and exited in one 10s cycle, while the leaders made money on all 5. 150 keeps most of the extra volume while staying above the scalp cluster. Do not lower it again on backtest evidence alone — the harness cannot see this cost.
PMBOT_COPY_VET_LEADERS=true         # backtest-vet each leader's tape before following
PMBOT_COPY_VET_LOOKBACK_DAYS=45     # vetting window
PMBOT_COPY_VET_MIN_PNL_USD=0        # drop leaders whose copy backtest nets below this
# 2026-08-06: vetting used to fail OPEN — a wallet with no copyable resolved
# trades was kept "no evidence either way". That let 0x3eae57 hold a slot while
# making 8 copyable trades in 45 days, and let wallets with no history at all in.
# Absence of evidence is now a rejection. top_n (leaders.yaml) is a CEILING, not
# a quota: the lineup is however many wallets are proven, which may be fewer.
PMBOT_COPY_VET_MIN_TRADES=10        # copyable resolved trades needed to judge at all
# A single recent window is in-sample by construction — the same window that
# surfaces a wallet then scores it, so a hot streak reads as skill. Require an
# older, non-overlapping window [90d, 45d) to be profitable too. Dry-run
# 2026-08-06 on 16 real candidates: 9 proven; this rule alone caught 0xbdb0e4
# (+$27 recent, -$125 prior) and 0xf0ea07 (no tape before the window).
PMBOT_COPY_VET_REQUIRE_CONSISTENCY=true
PMBOT_COPY_VET_OOS_LOOKBACK_DAYS=90 # older window is [this, LOOKBACK_DAYS) back
PMBOT_COPY_VET_OOS_MIN_TRADES=5     # lower bar: older tape is thinner (API caps
                                    # the trade feed at offset 10500, ~6 weeks
                                    # for a heavy trader)
PMBOT_COPY_VET_OOS_THIN_TRADES=15   # under this many trades the older window must
                                    # be outright PROFITABLE -- the _MIN_PNL slack
                                    # absorbs drift, and a window needs trades to
                                    # drift. 2026-08-27, replayed against real
                                    # fills over 131 vetting decisions: cuts 8
                                    # positions worth -$28.86 (realised -$69.46 ->
                                    # -$40.60) and spares 11 thin-but-profitable
                                    # windows that simply raising _MIN_TRADES to
                                    # 15 would have rejected for missing data.
# The older window SLIDES: each day it drops trades off the back and picks up
# newer ones at the front, so its P&L drifts even when the leader has not
# changed. Judged against the same $0 floor as the recent window, that drift
# became a firing pin — it dropped 0x5cd5c8d7 at -$17.13 on the very day its
# recent window hit a best-ever +$127.75 (and 0x06a22231 at -$4.51), while
# every leader it KEPT sat between +$14 and +$1,570. Blank = one maximum
# position (the RESOLVED per-market cap, so _PCT if set), i.e. an older window
# that lost less than a single bet is noise, not evidence.
# An EMPTY value is a startup error, not a blank (pydantic parses "" as a float
# and raises) — comment the line out to get the default.
# PINNED 2026-08-13: left explicit at -50 so dropping the per-market cap to 3%
# ($15) does not silently tighten LEADER VETTING from -$50 to -$15 slack. The
# vetting thresholds were tuned against a $50 position; re-tuning leader
# selection is a separate change from re-sizing copies, and this bot's leader
# set is hard-won. Unpin only alongside a fresh vetting dry-run.
PMBOT_COPY_VET_OOS_MIN_PNL_USD=-50
# ...but slack must not become a hole: the two windows TOGETHER still have to
# clear COPY_VET_MIN_PNL_USD, so a mild older loss is allowed only when the
# recent window more than pays for it.
PMBOT_COPY_VET_REQUIRE_COMBINED=true
PMBOT_COPY_VET_FAIL_OPEN=false      # a backtest error is not proof; skip the
                                    # wallet this rescore. _apply_rescore still
                                    # keeps the last good set if all drop out.
PMBOT_COPY_WEIGHT_BY_VET=false      # EXPERIMENTAL: up-size proven-copyable leaders (unvalidated)
PMBOT_COPY_MIN_HOURS_TO_RESOLUTION=0  # 0 = max profit; 6 = halve drawdown for ~1/3 less P&L

# --- Strategy #4 (long-term copy — legacy alternative, not wired by default) ---
PMBOT_LONGTERM_MIN_DAYS_TO_RESOLUTION=7  # only copy markets resolving >= N days out

# --- Paper fill model ---
PMBOT_SLIPPAGE_BPS=60               # assumed slippage in basis points (0.60%)

# --- Storage ---
PMBOT_DB_PATH=pmbot.db

# =========================================================================
# LIVE ONLY — leave blank until Phase 6 and only when lawfully able to trade.
# Polymarket CLOB uses an EOA private key + derived API creds.
# NEVER paste a key holding funds you can't afford to lose. NEVER commit it.
# =========================================================================
# PMBOT_PK=
# PMBOT_CLOB_API_KEY=
# PMBOT_CLOB_API_SECRET=
# PMBOT_CLOB_API_PASSPHRASE=
