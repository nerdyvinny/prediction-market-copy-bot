# Copy to .env and fill in. .env is gitignored — NEVER commit real secrets.

# Run mode: paper | backtest | live
PMBOT_MODE=paper

# --- Public, read-only APIs (no key needed for paper/backtest) ---
PMBOT_DATA_API_BASE=https://data-api.polymarket.com
PMBOT_GAMMA_API_BASE=https://gamma-api.polymarket.com
PMBOT_CLOB_API_BASE=https://clob.polymarket.com
PMBOT_KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# --- Poll loop ---
PMBOT_POLL_INTERVAL_SECONDS=10      # faster copy = less edge lost before the drift guard
PMBOT_SETTLE_INTERVAL_HOURS=0.5     # settle often: resolved-but-unsettled = idle bankroll

# --- Capital & sizing (paper defaults; keep < $1k for live) ---
PMBOT_BANKROLL_USD=500
PMBOT_COPY_FRACTION=0.10            # fraction of a leader's trade size (walk-forward tuned)
PMBOT_MAX_PER_MARKET_USD=100        # hard cap per market
PMBOT_MAX_PER_LEADER_USD=400        # hard cap of total exposure per leader
PMBOT_MIN_MARKET_LIQUIDITY_USD=5000 # skip thin markets (slippage)
PMBOT_COMPOUND_PROFITS=false        # redeploy realized winnings (validated worse ON in 45d test)

# --- Strategy #5 (exact copy — the default strategy) ---
PMBOT_COPY_PRICE_MIN=0.15           # entry band floor (sweep-tuned; sells never filtered)
PMBOT_COPY_PRICE_MAX=0.85           # entry band ceiling
PMBOT_COPY_MAX_PRICE_DRIFT=0.03     # skip if quote moved > this from leader's fill (stale edge)
PMBOT_COPY_MAX_TRADE_AGE_MINUTES=60 # never copy entries older than this (0 = off; exits exempt)
PMBOT_COPY_MIN_LEADER_NOTIONAL_USD=50   # 2026-08-01: 90d walk-forward on the live 7, 4/4 folds beat $300 (oos $4,986 vs $3,640, DD $441 vs $428, win 75.7% vs 73.8%). $0 scored higher still but copies $10 bets into ~$1 tickets where the flat-60bps slippage model is least trustworthy.
PMBOT_COPY_VET_LEADERS=true         # backtest-vet each leader's tape before following
PMBOT_COPY_VET_LOOKBACK_DAYS=45     # vetting window
PMBOT_COPY_VET_MIN_PNL_USD=0        # drop leaders whose copy backtest nets below this
PMBOT_COPY_WEIGHT_BY_VET=false      # EXPERIMENTAL: up-size proven-copyable leaders (unvalidated)
PMBOT_COPY_MIN_HOURS_TO_RESOLUTION=0  # 0 = max profit; 6 = halve drawdown for ~1/3 less P&L

# --- Strategy #4 (long-term copy — legacy alternative, not wired by default) ---
PMBOT_LONGTERM_MIN_DAYS_TO_RESOLUTION=7  # only copy markets resolving >= N days out

# --- Strategy #1 (cross-platform arbitrage: Polymarket <-> Kalshi) ---
PMBOT_ARB_ENABLED=false             # off by default; the bot's focus is copy trading
PMBOT_ARB_MIN_EDGE=0.015            # min net profit per $1 pair AFTER fees+buffer
PMBOT_ARB_SLIPPAGE_BUFFER=0.005     # haircut for books moving between scan and fill
PMBOT_ARB_MAX_PER_TRADE_USD=50      # budget per arb entry (both legs + fee)
PMBOT_ARB_MATCH_MIN_SIMILARITY=0.60 # fuzzy-match floor for SUGGESTIONS only
PMBOT_ARB_MATCH_MAX_CLOSE_DIFF_HOURS=30  # venues stamp dates differently; see settings.py
PMBOT_ARB_PAIRS_PATH=pmbot/config/arb_pairs.yaml
# Kalshi series to scan for matching (generic feed is all combo markets):
# PMBOT_KALSHI_SERIES=KXWCGAME,KXWCADVANCE,KXMLBGAME,...

# --- Paper fill model ---
PMBOT_SLIPPAGE_BPS=60               # assumed slippage in basis points (0.60%)

# --- Storage ---
PMBOT_DB_PATH=pmbot.db

# =========================================================================
# LIVE ONLY — leave blank until Phase 6 and only when lawfully able to trade.
# Polymarket CLOB uses an EOA private key + derived API creds.
# NEVER paste a key holding funds you can't afford to lose. NEVER commit it.
# =========================================================================
# PMBOT_PK=
# PMBOT_CLOB_API_KEY=
# PMBOT_CLOB_API_SECRET=
# PMBOT_CLOB_API_PASSPHRASE=
