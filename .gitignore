# Secrets — NEVER commit
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data / runtime artifacts
*.db
*.db.*
# WAL sidecars — the hyphen means *.db.* does NOT cover these.
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.json
logs/
*.log

# Tooling caches (regenerable; never commit)
graphify-out/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
